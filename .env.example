# ===== 口袋管家 部署配置模板 =====
# 用法：复制本文件为 .env，按服务器实际情况修改；.env 已被 .gitignore 忽略，不会提交

# 应用监听端口（反向代理/面板转发到这个端口）
PORT=3000

# 运行环境：production 时启用 https secure cookie（需前面有 https 反代）
NODE_ENV=production

# 会话加密密钥（生产环境务必改成一串足够长的随机值）
SESSION_SECRET=please-change-me-to-a-long-random-string

# ---- MySQL 数据库连接 ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=koudai
DB_CONNECTION_LIMIT=10
