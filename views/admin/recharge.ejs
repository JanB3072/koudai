<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>充值管理 - 口袋助手后台</title>
<link rel="stylesheet" href="/style.css">
<style>
  html,body{height:100%}
  body{margin:0;background:#f3f4f6;overflow:hidden}
  .admin-layout{display:flex;height:100vh;overflow:hidden}
  .sidebar{width:220px;background:#1a1f36;color:#fff;padding:20px 0;flex-shrink:0;position:sticky;top:0;height:100vh;overflow:hidden;box-sizing:border-box}
  .sidebar .brand{padding:0 20px 20px;font-size:18px;font-weight:700;border-bottom:1px solid #2a2f4a}
  .sidebar a{display:block;padding:12px 20px;color:#9ca3af;font-size:14px;text-decoration:none;transition:.2s}
  .sidebar a:hover,.sidebar a.active{background:#2a2f4a;color:#fff}
  .main{flex:1;height:100vh;padding:24px;display:flex;flex-direction:column;overflow:hidden;box-sizing:border-box}
  .topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px}
  .topbar h2{font-size:22px}
  .topbar .user-info{font-size:14px;color:#6b7280}
  .topbar .user-info a{color:#ef4444;margin-left:12px}
  .panel{background:#fff;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.06);overflow:hidden;margin-bottom:24px}
  .panel-head{padding:16px 20px;border-bottom:1px solid #e5e7eb;display:flex;justify-content:space-between;align-items:center}
  .panel-head h3{font-size:16px}
  .panel-body{padding:20px}
  .form-row{display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end}
  input,select{padding:8px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:13px}
  .btn{padding:8px 16px;border:none;border-radius:6px;font-size:13px;cursor:pointer;transition:.2s;text-decoration:none;display:inline-block}
  .btn-primary{background:#4f7cff;color:#fff}.btn-primary:hover{background:#3a5fd4}
  .btn-ghost{background:#eef2ff;color:#4f7cff}.btn-ghost:hover{background:#e0e7ff}
  .btn-sm{padding:4px 10px;font-size:12px}
  table{width:100%;border-collapse:collapse}
  th,td{padding:12px 20px;text-align:left;font-size:14px;border-bottom:1px solid #f3f4f6}
  th{background:#f9fafb;color:#6b7280;font-weight:500;font-size:12px;text-transform:uppercase}
  .amt-pos{color:#059669;font-weight:600}
  .amt-neg{color:#dc2626;font-weight:600}
  .table-scroll{flex:1;min-height:0;overflow:auto;border-bottom:1px solid #e5e7eb}
  .pager{display:flex;justify-content:space-between;align-items:center;padding:14px 20px;font-size:13px;color:#6b7280}
  .pager-btns{display:inline-flex;gap:8px}
  .list-panel{flex:1;display:flex;flex-direction:column;min-height:0;margin-bottom:0}
  .list-panel .panel-head{flex-shrink:0}
  .list-panel .pager{flex-shrink:0}
  .empty{padding:40px;text-align:center;color:#9ca3af}
  .banner{margin-bottom:16px;padding:12px 16px;border-radius:8px;font-size:14px}
  .banner-ok{background:#d1fae5;color:#065f46}
  .banner-err{background:#fee2e2;color:#991b1b}
  /* 可搜索下拉 */
  .ss{position:relative;min-width:200px}
  .ss-input{width:100%;box-sizing:border-box}
  .ss-list{position:fixed;z-index:1000;max-height:240px;overflow:auto;background:#fff;border:1px solid #d1d5db;border-radius:6px;box-shadow:0 4px 12px rgba(0,0,0,.12);display:none}
  .ss-opt{padding:8px 12px;font-size:13px;cursor:pointer;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .ss-opt:hover,.ss-opt.active{background:#eef2ff;color:#4f7cff}
  .ss-empty{padding:8px 12px;font-size:13px;color:#9ca3af}
</style>
</head>
<body>
<div class="admin-layout">
  <aside class="sidebar">
    <div class="brand">口袋助手后台</div>
    <a href="/admin">仪表盘</a>
    <a href="/admin/users">用户管理</a>
    <a href="/admin/accounts">账号管理</a>
    <a href="/admin/logs">扣费流水</a>
    <a href="/admin/recharge" class="active">充值管理</a>
    <a href="/admin/pricing">收费配置</a>
    <a href="/admin/checkin">签到配置</a>
    <a href="/admin/client">客户端资源</a>
    <a href="/admin/packages">安装包管理</a>
    <a href="/admin/settings">账号设置</a>
  </aside>
  <main class="main">
    <div class="topbar">
      <h2>充值管理</h2>
      <div class="user-info">欢迎，<%= admin %> | <a href="/admin/logout">退出</a></div>
    </div>

    <% if (msg) { %><div class="banner banner-ok"><%= msg %></div><% } %>
    <% if (error) { %><div class="banner banner-err"><%= error %></div><% } %>

    <div class="panel">
      <div class="panel-head"><h3>充值（点数累加到用户现有余额）</h3></div>
      <div class="panel-body">
        <form method="POST" action="/admin/recharge/do" class="form-row">
          <div>
            <div style="font-size:12px;color:#6b7280;margin-bottom:4px">选择用户（可搜索）</div>
            <div class="ss">
              <input type="text" id="userSearch" class="ss-input" placeholder="搜索用户名或ID…" autocomplete="off">
              <input type="hidden" name="user" id="userValue" value="<%= filter.userId %>">
              <div class="ss-list" id="userList"></div>
            </div>
          </div>
          <div>
            <div style="font-size:12px;color:#6b7280;margin-bottom:4px">充值点数（正数）</div>
            <input type="number" name="amount" placeholder="如 100" step="any" min="0.01" required>
          </div>
          <div>
            <div style="font-size:12px;color:#6b7280;margin-bottom:4px">备注</div>
            <input type="text" name="note" placeholder="可选">
          </div>
          <button type="submit" class="btn btn-primary">确认充值</button>
        </form>
      </div>
    </div>

    <div class="panel">
      <div class="panel-head"><h3>筛选</h3></div>
      <div class="panel-body">
        <form method="GET" action="/admin/recharge" class="form-row">
          <div>
            <div style="font-size:12px;color:#6b7280;margin-bottom:4px">用户ID</div>
            <input type="number" name="userId" placeholder="留空=全部" value="<%= filter.userId %>" style="width:120px">
          </div>
          <div>
            <div style="font-size:12px;color:#6b7280;margin-bottom:4px">日期</div>
            <input type="date" name="day" value="<%= filter.day %>" style="width:160px">
          </div>
          <button type="submit" class="btn btn-primary">查询</button>
          <a href="/admin/recharge" class="btn btn-ghost">重置</a>
        </form>
      </div>
    </div>

    <div class="panel list-panel">
      <div class="panel-head"><h3>充值记录 (<%= total %>)</h3></div>
      <div class="table-scroll">
        <% if(records && records.length){ %>
        <table>
          <thead><tr><th>ID</th><th>用户</th><th>新增点数</th><th>扣费点数</th><th>剩余点数</th><th>变动点数</th><th>备注</th><th>操作人</th><th>时间</th></tr></thead>
          <tbody>
            <% records.forEach(function(r){ %>
            <tr>
              <td><%= r.id %></td>
              <td><%= r.username %> <span style="color:#9ca3af">#<%= r.userId %></span></td>
              <td class="amt-pos"><%= fmtMoney(r.addedPoints) %></td>
              <td class="amt-neg"><%= fmtMoney(r.deductedPoints) %></td>
              <td><b><%= fmtMoney(r.remainingPoints) %></b></td>
              <td class="<%= r.amount>=0?'amt-pos':'amt-neg' %>"><%= (r.amount>=0?'+':'') + fmtMoney(r.amount) %></td>
              <td><%= r.note %></td>
              <td><%= r.admin %></td>
              <td><%= r.createdAt %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
        <% } else { %>
        <div class="empty">暂无充值记录</div>
        <% } %>
      </div>
      <div class="pager">
        <span>共 <%= total %> 条 · 第 <%= page %> / <%= totalPages %> 页</span>
        <span class="pager-btns">
          <% if(page>1){ %><a class="btn btn-sm btn-ghost" href="?userId=<%= filter.userId %>&day=<%= filter.day %>&page=<%= page-1 %>">上一页</a><% } %>
          <% if(page<totalPages){ %><a class="btn btn-sm btn-ghost" href="?userId=<%= filter.userId %>&day=<%= filter.day %>&page=<%= page+1 %>">下一页</a><% } %>
        </span>
      </div>
    </div>
  </main>
</div>
<script>
(function(){
  var users = <%- JSON.stringify(users || []) %>;
  var input = document.getElementById('userSearch');
  var hidden = document.getElementById('userValue');
  var list = document.getElementById('userList');
  var wrap = document.querySelector('.ss');
  var active = -1;
  function esc(s){return String(s).replace(/[&<>"']/g, function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
  // fixed 定位：按输入框实时坐标放置，避免被父级 overflow:hidden 裁剪
  function place(){
    var r = input.getBoundingClientRect();
    list.style.left = r.left + 'px';
    list.style.top = (r.bottom + 4) + 'px';
    list.style.width = r.width + 'px';
  }
  function render(q){
    q = (q||'').trim().toLowerCase();
    var m = users.filter(function(u){return !q || String(u.id).indexOf(q) >= 0 || (u.username||'').toLowerCase().indexOf(q) >= 0;}).slice(0, 50);
    place();
    if(!m.length){ list.innerHTML = '<div class="ss-empty">无匹配用户</div>'; list.style.display = 'block'; return; }
    list.innerHTML = m.map(function(u, i){
      return '<div class="ss-opt' + (i === active ? ' active' : '') + '" data-id="' + u.id + '" data-label="' + u.id + ' · ' + esc(u.username) + '">' + u.id + ' · ' + esc(u.username) + '</div>';
    }).join('');
    list.style.display = 'block';
  }
  function choose(el){ input.value = el.getAttribute('data-label'); hidden.value = el.getAttribute('data-id'); list.style.display = 'none'; active = -1; }
  input.addEventListener('focus', function(){ active = -1; render(input.value); });
  input.addEventListener('input', function(){ active = -1; render(input.value); });
  input.addEventListener('keydown', function(e){
    var opts = list.querySelectorAll('.ss-opt');
    if(e.key === 'ArrowDown'){ active = Math.min(active + 1, opts.length - 1); render(input.value); e.preventDefault(); }
    else if(e.key === 'ArrowUp'){ active = Math.max(active - 1, 0); render(input.value); e.preventDefault(); }
    else if(e.key === 'Enter'){ if(active >= 0 && opts[active]) choose(opts[active]); e.preventDefault(); }
    else if(e.key === 'Escape'){ list.style.display = 'none'; }
  });
  list.addEventListener('mousedown', function(e){ var el = e.target.closest('.ss-opt'); if(el) choose(el); });
  // 把列表挂到 body：.panel / .main 都有 overflow:hidden，留在内部会被裁剪，导致列表显示不全、看似无法滚动/选中
  document.body.appendChild(list);
  function inPicker(el){ return wrap.contains(el) || list.contains(el); }
  document.addEventListener('click', function(e){ if(!inPicker(e.target)) list.style.display = 'none'; });
  window.addEventListener('resize', function(){ if(list.style.display === 'block') place(); });
  // 不监听 scroll：body 为 overflow:hidden，文档不滚动，fixed 列表坐标稳定；
  // 原实现在捕获阶段监听所有 scroll，列表自身滚动会被误判并隐藏，故彻底移除。
  // 预填已选用户（筛选/充值后回显）
  if(hidden.value){ var u = users.filter(function(x){return String(x.id) === String(hidden.value);})[0]; if(u) input.value = u.id + ' · ' + u.username; }
})();
</script>
</body>
</html>
