<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>充值记录 - 口袋管家后台</title>
<link rel="stylesheet" href="/style.css">
<style>
  html,body{height:100%}
  body{margin:0;background:#f3f4f6;overflow:hidden}
  .admin-layout{display:flex;height:100vh;overflow:hidden}
  .sidebar{width:220px;background:#1a1f36;color:#fff;padding:20px 0;flex-shrink:0;position:sticky;top:0;height:100vh;overflow:hidden;box-sizing:border-box}
  .sidebar .brand{padding:0 20px 20px;font-size:18px;font-weight:700;border-bottom:1px solid #2a2f4a}
  .sidebar a{display:block;padding:12px 20px;color:#9ca3af;font-size:14px;text-decoration:none;transition:.2s}
  .sidebar a:hover,.sidebar a.active{background:#2a2f4a;color:#fff}
  .main{flex:1;height:100vh;padding:24px;display:flex;flex-direction:column;overflow:hidden;box-sizing:border-box}
  .topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px}
  .topbar h2{font-size:22px}
  .topbar .user-info{font-size:14px;color:#6b7280}
  .topbar .user-info a{color:#ef4444;margin-left:12px}
  .panel{background:#fff;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.06);overflow:hidden;margin-bottom:24px}
  .panel-head{padding:16px 20px;border-bottom:1px solid #e5e7eb;display:flex;justify-content:space-between;align-items:center}
  .panel-head h3{font-size:16px}
  .panel-body{padding:20px}
  .form-row{display:flex;gap:12px;flex-wrap:wrap;align-items:flex-end}
  input,select{padding:8px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:13px}
  .btn{padding:8px 16px;border:none;border-radius:6px;font-size:13px;cursor:pointer;transition:.2s;text-decoration:none;display:inline-block}
  .btn-primary{background:#4f7cff;color:#fff}.btn-primary:hover{background:#3a5fd4}
  .btn-ghost{background:#eef2ff;color:#4f7cff}.btn-ghost:hover{background:#e0e7ff}
  .btn-sm{padding:4px 10px;font-size:12px}
  table{width:100%;border-collapse:collapse}
  th,td{padding:12px 20px;text-align:left;font-size:14px;border-bottom:1px solid #f3f4f6}
  th{background:#f9fafb;color:#6b7280;font-weight:500;font-size:12px;text-transform:uppercase}
  .amt-pos{color:#059669;font-weight:600}
  .amt-neg{color:#dc2626;font-weight:600}
  .table-scroll{flex:1;min-height:0;overflow:auto;border-bottom:1px solid #e5e7eb}
  .pager{display:flex;justify-content:space-between;align-items:center;padding:14px 20px;font-size:13px;color:#6b7280}
  .pager-btns{display:inline-flex;gap:8px}
  .list-panel{flex:1;display:flex;flex-direction:column;min-height:0;margin-bottom:0}
  .list-panel .panel-head{flex-shrink:0}
  .list-panel .pager{flex-shrink:0}
  .empty{padding:40px;text-align:center;color:#9ca3af}
</style>
</head>
<body>
<div class="admin-layout">
  <aside class="sidebar">
    <div class="brand">口袋管家后台</div>
    <a href="/admin">仪表盘</a>
    <a href="/admin/users">用户管理</a>
    <a href="/admin/accounts">账号管理</a>
    <a href="/admin/logs">扣费流水</a>
    <a href="/admin/recharge" class="active">充值记录</a>
    <a href="/admin/pricing">收费配置</a>
    <a href="/admin/checkin">签到配置</a>
    <a href="/admin/settings">账号设置</a>
  </aside>
  <main class="main">
    <div class="topbar">
      <h2>充值记录</h2>
      <div class="user-info">欢迎，<%= admin %> | <a href="/admin/logout">退出</a></div>
    </div>

    <div class="panel">
      <div class="panel-head"><h3>筛选</h3></div>
      <div class="panel-body">
        <form method="GET" action="/admin/recharge" class="form-row">
          <div>
            <div style="font-size:12px;color:#6b7280;margin-bottom:4px">用户ID</div>
            <input type="number" name="userId" placeholder="留空=全部" value="<%= filter.userId %>" style="width:120px">
          </div>
          <div>
            <div style="font-size:12px;color:#6b7280;margin-bottom:4px">日期</div>
            <input type="date" name="day" value="<%= filter.day %>" style="width:160px">
          </div>
          <button type="submit" class="btn btn-primary">查询</button>
          <a href="/admin/recharge" class="btn btn-ghost">重置</a>
        </form>
      </div>
    </div>

    <div class="panel list-panel">
      <div class="panel-head"><h3>充值记录 (<%= total %>)</h3></div>
      <div class="table-scroll">
        <% if(records && records.length){ %>
        <table>
          <thead><tr><th>ID</th><th>用户</th><th>新增点数</th><th>扣费点数</th><th>剩余点数</th><th>变动点数</th><th>备注</th><th>操作人</th><th>时间</th></tr></thead>
          <tbody>
            <% records.forEach(function(r){ %>
            <tr>
              <td><%= r.id %></td>
              <td><%= r.username %> <span style="color:#9ca3af">#<%= r.userId %></span></td>
              <td class="amt-pos"><%= r.addedPoints.toFixed(2) %></td>
              <td class="amt-neg"><%= r.deductedPoints.toFixed(2) %></td>
              <td><b><%= r.remainingPoints.toFixed(2) %></b></td>
              <td class="<%= r.amount>=0?'amt-pos':'amt-neg' %>"><%= (r.amount>=0?'+':'') + r.amount.toFixed(2) %></td>
              <td><%= r.note %></td>
              <td><%= r.admin %></td>
              <td><%= r.createdAt %></td>
            </tr>
            <% }) %>
          </tbody>
        </table>
        <% } else { %>
        <div class="empty">暂无充值记录</div>
        <% } %>
      </div>
      <div class="pager">
        <span>共 <%= total %> 条 · 第 <%= page %> / <%= totalPages %> 页</span>
        <span class="pager-btns">
          <% if(page>1){ %><a class="btn btn-sm btn-ghost" href="?userId=<%= filter.userId %>&day=<%= filter.day %>&page=<%= page-1 %>">上一页</a><% } %>
          <% if(page<totalPages){ %><a class="btn btn-sm btn-ghost" href="?userId=<%= filter.userId %>&day=<%= filter.day %>&page=<%= page+1 %>">下一页</a><% } %>
        </span>
      </div>
    </div>
  </main>
</div>
</body>
</html>
