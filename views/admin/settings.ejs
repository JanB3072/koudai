<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>账号设置 - 口袋助手后台</title>
<link rel="stylesheet" href="/style.css">
<style>
  html,body{height:100%}
  body{margin:0;background:#f3f4f6;overflow:hidden}
  .admin-layout{display:flex;height:100vh;overflow:hidden}
  .sidebar{width:220px;background:#1a1f36;color:#fff;padding:20px 0;flex-shrink:0;position:sticky;top:0;height:100vh;overflow:hidden;box-sizing:border-box}
  .sidebar .brand{padding:0 20px 20px;font-size:18px;font-weight:700;border-bottom:1px solid #2a2f4a}
  .sidebar a{display:block;padding:12px 20px;color:#9ca3af;font-size:14px;text-decoration:none;transition:.2s}
  .sidebar a:hover,.sidebar a.active{background:#2a2f4a;color:#fff}
  .main{flex:1;height:100vh;padding:24px;display:flex;flex-direction:column;overflow-y:auto;box-sizing:border-box}
  .topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px}
  .topbar h2{font-size:22px}
  .topbar .user-info{font-size:14px;color:#6b7280}
  .topbar .user-info a{color:#ef4444;margin-left:12px}
  .panel{background:#fff;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.06);overflow:hidden;max-width:500px}
  .panel-head{padding:16px 20px;border-bottom:1px solid #e5e7eb}
  .panel-head h3{font-size:16px}
  .panel-body{padding:24px}
  .form-group{margin-bottom:16px}
  .form-group label{display:block;font-size:13px;color:#374151;margin-bottom:6px;font-weight:500}
  .form-group input{width:100%;padding:10px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:14px}
  .btn{padding:10px 24px;border:none;border-radius:6px;font-size:14px;cursor:pointer;transition:.2s}
  .btn-primary{background:#4f7cff;color:#fff}.btn-primary:hover{background:#3a5fd4}
  .alert-error{background:#fef2f2;color:#dc2626;padding:10px 16px;border-radius:8px;font-size:13px;margin-bottom:16px}
  .alert-success{background:#d1fae5;color:#065f46;padding:10px 16px;border-radius:8px;font-size:13px;margin-bottom:16px}
  .hint{font-size:13px;color:#6b7280;margin:0 0 16px;background:#f9fafb;padding:10px 12px;border-radius:6px;border:1px solid #e5e7eb;line-height:1.6}
  .hint code{background:#eef2ff;padding:1px 6px;border-radius:4px;color:#4f7cff}
  .muted{color:#6b7280;font-size:13px}
  .msg{font-size:13px}.msg-ok{color:#10b981}.msg-err{color:#ef4444}
  .switch{position:relative;display:inline-block;width:46px;height:24px}
  .switch input{opacity:0;width:0;height:0}
  .slider{position:absolute;cursor:pointer;inset:0;background:#d1d5db;border-radius:24px;transition:.2s}
  .slider:before{content:"";position:absolute;height:18px;width:18px;left:3px;top:3px;background:#fff;border-radius:50%;transition:.2s}
  .switch input:checked + .slider{background:#4f7cff}
  .switch input:checked + .slider:before{transform:translateX(22px)}
</style>
</head>
<body>
<div class="admin-layout">
  <aside class="sidebar">
    <div class="brand">口袋助手后台</div>
    <a href="/admin">仪表盘</a>
    <a href="/admin/users">用户管理</a>
    <a href="/admin/accounts">账号管理</a>
    <a href="/admin/logs">扣费流水</a>
    <a href="/admin/recharge">充值管理</a>
    <a href="/admin/pricing">收费配置</a>
    <a href="/admin/client">客户端资源</a>
    <a href="/admin/packages">安装包管理</a>
    <a href="/admin/settings" class="active">账号设置</a>
  </aside>
  <main class="main">
    <div class="topbar">
      <h2>账号设置</h2>
      <div class="user-info">欢迎，<%= admin %> | <a href="/admin/logout">退出</a></div>
    </div>

    <div class="panel">
      <div class="panel-head"><h3>修改管理员密码</h3></div>
      <div class="panel-body">
        <% if(error) { %><div class="alert-error"><%= error %></div><% } %>
        <% if(success) { %><div class="alert-success"><%= success %></div><% } %>
        <form method="POST" action="/admin/settings">
          <div class="form-group">
            <label>当前账号</label>
            <input type="text" value="<%= admin %>" disabled>
          </div>
          <div class="form-group">
            <label>原密码</label>
            <input type="password" name="oldPassword" required>
          </div>
          <div class="form-group">
            <label>新密码（至少6位）</label>
            <input type="password" name="newPassword" required>
          </div>
          <button type="submit" class="btn btn-primary">保存修改</button>
        </form>
      </div>
    </div>

    <div class="panel" style="margin-top:20px">
      <div class="panel-head"><h3>扣费计划（按时间结算扣分）</h3></div>
      <div class="panel-body">
        <p class="hint">启用后系统按真实时间结算：默认账号「正常」= 启用工具（10点/小时），否则 20点/天。可用 <code>POST /api/points/settle</code> 由定时任务触发，或访问 /api-docs 调试。</p>
        <div class="form-group" style="display:flex;align-items:center;gap:12px">
          <label style="margin:0">计划开关</label>
          <label class="switch"><input type="checkbox" id="planEnabled"><span class="slider"></span></label>
          <span id="planStatus" class="muted">加载中…</span>
        </div>
        <button type="button" id="savePlan" class="btn btn-primary">保存设置</button>
        <span id="planMsg" class="msg" style="margin-left:12px"></span>
      </div>
    </div>
  </main>
</div>

  <script>
  fetch('/api/points/plan').then(r=>r.json()).then(d=>{
    document.getElementById('planEnabled').checked = !!d.enabled;
    document.getElementById('planStatus').textContent = d.enabled ? '已启用' : '已关闭';
  }).catch(()=>{ document.getElementById('planStatus').textContent='读取失败'; });
  document.getElementById('savePlan').onclick = async () => {
    const enabled = document.getElementById('planEnabled').checked;
    const r = await fetch('/api/points/plan', {method:'POST', headers:{'Content-Type':'application/json'}, body: JSON.stringify({enabled})});
    const j = await r.json();
    const m = document.getElementById('planMsg');
    if(j.success){ m.className='msg msg-ok'; m.textContent='已'+(j.enabled?'启用':'关闭'); document.getElementById('planStatus').textContent = j.enabled?'已启用':'已关闭'; }
    else { m.className='msg msg-err'; m.textContent = j.message || '失败'; }
  };
  </script>
</body>
</html>