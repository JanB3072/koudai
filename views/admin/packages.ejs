<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>安装包管理 - 口袋助手后台</title>
<link rel="stylesheet" href="/style.css">
<style>
  html,body{height:100%}
  body{margin:0;background:#f3f4f6;overflow:hidden}
  .admin-layout{display:flex;height:100vh;overflow:hidden}
  .sidebar{width:220px;background:#1a1f36;color:#fff;padding:20px 0;flex-shrink:0;position:sticky;top:0;height:100vh;overflow-y:auto;box-sizing:border-box}
  .sidebar .brand{padding:0 20px 20px;font-size:18px;font-weight:700;border-bottom:1px solid #2a2f4a}
  .sidebar a{display:block;padding:12px 20px;color:#9ca3af;font-size:14px;text-decoration:none;transition:.2s}
  .sidebar a:hover,.sidebar a.active{background:#2a2f4a;color:#fff}
  .main{flex:1;height:100vh;padding:24px;display:block;overflow-y:auto;box-sizing:border-box}
  .topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px}
  .topbar h2{font-size:22px}
  .topbar .user-info{font-size:14px;color:#6b7280}
  .topbar .user-info a{color:#ef4444;margin-left:12px}
  .panel{background:#fff;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.06);overflow:hidden;margin-bottom:20px}
  .panel-head{padding:16px 20px;border-bottom:1px solid #e5e7eb}
  .panel-head h3{font-size:16px}
  .panel-body{padding:24px}
  .form-group{margin-bottom:16px}
  .form-group label{display:block;font-size:13px;color:#374151;margin-bottom:6px;font-weight:500}
  .form-group input[type=text],.form-group input[type=file]{width:100%;padding:10px 12px;border:1px solid #d1d5db;border-radius:6px;font-size:14px;box-sizing:border-box}
  .btn{padding:10px 24px;border:none;border-radius:6px;font-size:14px;cursor:pointer;transition:.2s}
  .btn-primary{background:#4f7cff;color:#fff}.btn-primary:hover{background:#3a5fd4}
  .btn-danger{background:#ef4444;color:#fff}.btn-danger:hover{background:#dc2626}
  .alert-error{background:#fef2f2;color:#dc2626;padding:10px 16px;border-radius:8px;font-size:13px;margin-bottom:16px}
  .alert-ok{background:#d1fae5;color:#065f46;padding:10px 16px;border-radius:8px;font-size:13px;margin-bottom:16px}
  .hint{font-size:13px;color:#6b7280;margin:0 0 16px;background:#f9fafb;padding:10px 12px;border-radius:6px;border:1px solid #e5e7eb;line-height:1.6}
  .hint code{background:#eef2ff;padding:1px 6px;border-radius:4px;color:#4f7cff}
  table{width:100%;border-collapse:collapse}
  th,td{padding:10px 20px;text-align:left;font-size:13px;border-bottom:1px solid #f3f4f6}
  th{background:#f9fafb;color:#6b7280;font-weight:500;font-size:12px}
  td.mono{font-family:Consolas,monospace;color:#6b7280;font-size:11px;word-break:break-all}
  .empty{color:#9ca3af;font-size:13px;padding:20px;text-align:center}
  .dl{color:#4f7cff;text-decoration:none;font-size:13px}
</style>
</head>
<body>
<div class="admin-layout">
  <aside class="sidebar">
    <div class="brand">口袋助手后台</div>
    <a href="/admin">仪表盘</a>
    <a href="/admin/users">用户管理</a>
    <a href="/admin/accounts">账号管理</a>
    <a href="/admin/logs">扣费流水</a>
    <a href="/admin/recharge">充值管理</a>
    <a href="/admin/pricing">收费配置</a>
    <a href="/admin/checkin">签到配置</a>
    <a href="/admin/client">客户端资源</a>
    <a href="/admin/packages" class="active">安装包管理</a>
    <a href="/admin/settings">账号设置</a>
  </aside>
  <main class="main">
    <div class="topbar">
      <h2>脚本 / ZIP 资源包管理</h2>
      <div class="user-info">欢迎，<%= admin %> | <a href="/admin/logout">退出</a></div>
    </div>

    <% if(error) { %><div class="alert-error">操作失败：<%= error %></div><% } %>
    <% if(msg) { %><div class="alert-ok"><%= msg %></div><% } %>

    <div class="panel">
      <div class="panel-head"><h3>上传脚本 / 压缩包</h3></div>
      <div class="panel-body">
        <p class="hint">仅超管可上传。本页只放<strong>脚本与 ZIP 类资源包</strong>：zip / war / jar / tar.gz / 7z / rar、以及 js / json / py / sh / bat / ps1 等脚本；<strong>.exe 客户端安装程序请到「客户端资源」上传</strong>。单包上限 20MB（D1 分块存储），登录用户可通过 <code>/api/packages</code> 获取 <code>/pkg/&lt;id&gt;</code> 下载地址。</p>
        <form method="POST" action="/admin/packages/upload" enctype="multipart/form-data">
          <div class="form-group">
            <label>脚本 / 压缩包文件</label>
            <input type="file" name="file" accept=".zip,.war,.jar,.tar,.gz,.tgz,.7z,.rar,.xz,.bz2,.js,.json,.py,.sh,.bat,.cmd,.ps1,.txt,.xml,.html,.css" required>
          </div>
          <div class="form-group">
            <label>版本号（可选，如 1.2.0）</label>
            <input type="text" name="version" placeholder="例如 1.2.0" pattern="\d+(\.\d+){0,3}">
          </div>
          <button type="submit" class="btn btn-primary">上传资源包</button>
        </form>
      </div>
    </div>

    <div class="panel">
      <div class="panel-head"><h3>已上传脚本 / 资源包（<%= packages.length %>）</h3></div>
      <% if(packages.length) { %>
      <table>
        <thead><tr><th>文件名</th><th>版本</th><th>大小</th><th>SHA-256</th><th>上传者</th><th>时间</th><th>操作</th></tr></thead>
        <tbody>
          <% packages.forEach(function(r){ %>
          <tr>
            <td><%= r.name %></td>
            <td><%= r.version || '-' %></td>
            <td><%= (r.size/1024/1024).toFixed(2) %> MB</td>
            <td class="mono"><%= r.sha256 %></td>
            <td><%= r.uploaded_by %></td>
            <td><%= r.created_at %></td>
            <td>
              <a class="dl" href="/pkg/<%= r.pkg_key %>">下载</a>
              <form method="POST" action="/admin/packages/delete" style="display:inline" onsubmit="return confirm('确定删除 <%= r.name %>？')">
                <input type="hidden" name="key" value="<%= r.pkg_key %>">
                <button type="submit" class="btn btn-danger" style="padding:4px 12px;font-size:12px;margin-left:8px">删除</button>
              </form>
            </td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } else { %>
      <div class="empty">暂无脚本 / 资源包</div>
      <% } %>
    </div>
  </main>
</div>
</body>
</html>
