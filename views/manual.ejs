function renderM(cat){
  const list=mfeats[cat]||[];
  document.getElementById('mfContent').innerHTML=list.map(f=>`
    <div style="border-bottom:1px solid var(--border);padding:16px 0">
      <h4 style="margin:0 0 8px">${f.name}</h4>
      <p style="margin-bottom:8px">${f.desc}</p>
      <p><strong>适用场景：</strong>${f.scene}</p>
      <p><strong>开启前检查：</strong></p>
      <ul>${f.check.map(c=>`<li>${c}</li>`).join('')}</ul>
      ${f.tips?`<p style="margin-top:8px"><strong>使用建议：</strong>${f.tips}</p>`:''}
      ${f.warn?`<p style="margin-top:8px;color:var(--danger)"><strong>注意：</strong>${f.warn}</p>`:''}
    </div>`).join('');
}
renderM('battle');
document.querySelectorAll('#mfTabs .tab').forEach(t=>{
  t.addEventListener('click',()=>{
    document.querySelectorAll('#mfTabs .tab').forEach(x=>x.classList.remove('active'));
    t.classList.add('active');
    renderM(t.dataset.m);
  });
});
