{name:'钻石统计',cat:'tool',risk:false,desc:'统计钻石收入与消耗变化，帮助核对活动投入和账号资源波动。'}
];
const catName={'all':'全部','battle':'战斗出征','gather':'资源采集','alliance':'联盟互动','daily':'日常福利','event':'限时活动','c8':'跨服玩法','tool':'统计工具'};
function render(cat){
  const list=cat==='all'?feats:feats.filter(f=>f.cat===cat);
  document.getElementById('featGrid').innerHTML=list.map(f=>`
    <div class="card">
      <div style="display:flex;justify-content:space-between;align-items:start;margin-bottom:8px">
        <h3 style="margin:0;font-size:16px">${f.name}</h3>
        <span class="badge ${f.risk?'badge-risk':'badge-normal'}">${f.risk?'有风险提示':'常规功能'}</span>
      </div>
      <div style="font-size:12px;color:var(--primary);margin-bottom:8px">${catName[f.cat]}</div>
      <p style="font-size:13px">${f.desc}</p>
    </div>`).join('');
}
render('all');
document.querySelectorAll('#catTabs .tab').forEach(t=>{
  t.addEventListener('click',()=>{
    document.querySelectorAll('#catTabs .tab').forEach(x=>x.classList.remove('active'));
    t.classList.add('active');
    render(t.dataset.cat);
  });
});
</script>
