const catName = Object.fromEntries(CATS.map(c => [c.key, c.name]));
let curCat = 'all';

function renderTabs() {
  document.getElementById('catTabs').innerHTML =
    '<button class="tab' + (curCat === 'all' ? ' active' : '') + '" data-c="all">全部 (' + FEATS.length + ')</button>' +
    CATS.map(c => {
      const n = FEATS.filter(f => f.c === c.key).length;
      return '<button class="tab' + (curCat === c.key ? ' active' : '') + '" data-c="' + c.key + '">' + c.name + ' (' + n + ')</button>';
    }).join('');
  document.querySelectorAll('#catTabs .tab').forEach(t => t.addEventListener('click', () => { curCat = t.dataset.c; renderTabs(); render(); }));
}
function render() {
  const kw = document.getElementById('featSearch').value.trim().toLowerCase();
  let list = curCat === 'all' ? FEATS : FEATS.filter(f => f.c === curCat);
  if (kw) list = list.filter(f => (f.n + f.id + f.d).toLowerCase().includes(kw));
  document.getElementById('featGrid').innerHTML = list.map(f =>
    '<div class="card2">' +
      '<div style="display:flex;justify-content:space-between;gap:10px;align-items:start;margin-bottom:6px">' +
        '<h3 style="margin:0">' + f.n + '</h3>' +
        (f.r ? '<span class="tag tag-risk">有风险提示</span>' : '<span class="tag tag-ok">常规</span>') +
      '</div>' +
      '<div style="font-size:11.5px;color:var(--brand-deep);font-family:Consolas,monospace;margin-bottom:8px">' + catName[f.c] + ' · ' + f.id + '</div>' +
      '<p>' + f.d + '</p>' +
    '</div>').join('');
  document.getElementById('emptyTip').style.display = list.length ? 'none' : 'block';
}
renderTabs();
render();
document.getElementById('featSearch').addEventListener('input', render);
</script>
<script src="/auth.js"></script>
</body>
</html>
