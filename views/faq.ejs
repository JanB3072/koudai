    ['门户能看到/导出我的游戏凭证吗？','按产品设计，门户只应展示角色名、头像、uid、区服、最后登录和凭证状态，不应展示或导出凭证字段；当前服务端接口仍可能返回这些字段，属于待加固项，发现请立即反馈。']
  ]}
];
const flat = [];
GROUPS.forEach(g => g.items.forEach(it => flat.push({ g: g.name, q: it[0], a: it[1] })));

function render() {
  const kw = document.getElementById('faqSearch').value.trim().toLowerCase();
  const wrap = document.getElementById('faqWrap');
  let html = '', count = 0;
  GROUPS.forEach(g => {
    const items = g.items.filter(it => !kw || (it[0] + it[1]).toLowerCase().includes(kw));
    if (!items.length) return;
    count += items.length;
    html += '<div class="acc-group">' + g.name + '（' + items.length + '）</div>';
    items.forEach(it => {
      html += '<div class="acc"><div class="acc-q">' + it[0] + '</div><div class="acc-a">' + it[1] + '</div></div>';
    });
  });
  wrap.innerHTML = html;
  document.getElementById('emptyTip').style.display = count ? 'none' : 'block';
  wrap.querySelectorAll('.acc-q').forEach(q => q.addEventListener('click', () => q.parentElement.classList.toggle('open')));
}
render();
document.getElementById('faqSearch').addEventListener('input', render);

// GEO：复用同一份 FAQ 数据生成 FAQPage 结构化数据，便于 AI 搜索 / 富摘要抓取
(function () {
  try {
    var ld = {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": flat.map(function (it) {
        return { "@type": "Question", "name": it.q, "acceptedAnswer": { "@type": "Answer", "text": it.a } };
      })
    };
    var s = document.createElement('script');
    s.type = 'application/ld+json';
    s.textContent = JSON.stringify(ld);
    document.head.appendChild(s);
  } catch (e) {}
})();
</script>
<script src="/auth.js"></script>
</body>
</html>
