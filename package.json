{
  "name": "koudai-new",
  "version": "1.0.0",
  "description": "口袋助手 - 游戏账号管理与云端托管平台（Cloudflare Workers + D1 版本）",
  "private": true,
  "main": "worker/index.js",
  "scripts": {
    "start": "wrangler dev",
    "cf:dev": "wrangler dev",
    "cf:deploy": "npm run build:views && wrangler deploy",
    "build:views": "node scripts/build-views.mjs",
    "cf:migrate:local": "wrangler d1 migrations apply koudai --local",
    "cf:migrate:remote": "wrangler d1 migrations apply koudai --remote"
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "wrangler": "^3.80.0"
  }
}
